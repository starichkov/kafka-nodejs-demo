{
  "name": "kafka-nodejs-demo",
  "version": "1.0.0",
  "description": "Simple Kafka producer and consumer with tests",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start:producer": "node src/producer.js",
    "start:consumer": "node src/consumer.js",
    "inspect:topic": "node src/topic-admin.js",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit --coverage",
    "test:docker": "./test-docker-compose.sh",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\""
  },
  "keywords": [
    "kafka",
    "kafkajs",
    "producer",
    "consumer"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "kafkajs": "^2.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^30.5.2",
    "@testcontainers/kafka": "^12.2.1",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "testcontainers": "^12.2.1"
  },
  "overrides": {
    "glob": "~14.0.4",
    "minimatch": "~11.0.5"
  },
  "jest": {
    "testEnvironment": "node",
    "globalSetup": "./jest-global-setup.js",
    "globalTeardown": "./jest-global-teardown.js",
    "maxWorkers": 1,
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "verbose": true,
    "coverageProvider": "v8",
    "coverageDirectory": "coverage",
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov"
    ],
    "collectCoverageFrom": [
      "src/**/*.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/tests/"
    ]
  }
}
